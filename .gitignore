# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# Living Sakura founder still-pack PNGs (regenerate with npm run still-pack:living-sakura)
.living-sakura/renders/**/*.png
.living-sakura/renders/**/*.jpg
.living-sakura/renders/**/*.webp
.living-sakura/renders/*.png
.living-sakura/renders/*.jpg
.living-sakura/renders/*.webp

# Prototype stills and texture dumps (source models under .img2threejs/generated stay)
.img2threejs/**/*.png
.img2threejs/**/*.jpg
.img2threejs/**/*.jpeg
.img2threejs/**/*.webp
.img2threejs-v2/**/*.png
.img2threejs-v2/**/*.jpg
.img2threejs-v2/**/*.jpeg
.img2threejs-v2/**/*.webp

# Local captures and one-off diagnostics
/*.png
/*.jpg
/*.jpeg
/tmp-*/
tmp-*.mts
tmp-*.ts

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
