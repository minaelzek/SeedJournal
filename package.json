{
  "name": "seed-journal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state",
    "test": "npm run test:unit && npm run test:integration",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config tests/garden-vitest.config.ts && vitest run --config tests/security-vitest.config.ts && vitest run --config tests/reflection-vitest.config.ts && vitest run --config tests/growth-vitest.config.ts",
    "test:integration": "node --test tests/rendered-html.test.mjs",
    "pretest:e2e": "cross-env SEED_JOURNAL_RESET_CONFIRMATION=RESET npm run db:reset && npm run build",
    "test:e2e": "playwright test",
    "still-pack:living-sakura": "playwright test tests/e2e/living-sakura-still-pack.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run build && npm audit --omit=dev --audit-level=high",
    "verify:staging": "npm run test:e2e && wrangler deploy --dry-run --config dist/server/wrangler.json",
    "db:migrate": "wrangler d1 migrations apply seed-journal-d1 --local --persist-to .wrangler/state",
    "db:reset": "node scripts/reset-local-db.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.8",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "axe-core": "^4.12.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "nanoid": "3.3.20",
    "source-map-js": "1.2.2"
  }
}
